# Identificador publico del proyecto. No es un secreto.
SUPABASE_PROJECT_REF=lepivdjhmuzlinfhxsyr

# Copiar la URI "Session pooler" del panel de Supabase (puerto 5432) y
# reemplazar [YOUR-PASSWORD]. Si contiene caracteres especiales, codificarla
# para URL. Nunca versionar el archivo .env real.
DATABASE_URL=postgresql://postgres.lepivdjhmuzlinfhxsyr:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:5432/postgres?sslmode=require

# Solo se usa para `supabase link`/`db push`; dejar vacio en este ejemplo.
SUPABASE_DB_PASSWORD=
